SECRET_KEY=change-this-secret-key
API_KEY=change-this-admin-api-key
DEBUG=true
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
CAMERA_INDEX=0
MODEL_INPUT_DIM=126
# Set to temporal_landmark when deploying a WLASL-trained model.
# Use mlp only for the older static-gesture MLP model.
MODEL_TYPE=temporal_landmark
SEQUENCE_LENGTH=30
PREDICTION_CONFIDENCE_THRESHOLD=0.75
MP_MIN_DETECTION_CONFIDENCE=0.5
MP_MIN_TRACKING_CONFIDENCE=0.5
# Set LABELS_COUNT to match the number of classes in your trained label_map.json
# (e.g. 50, 100, or 300 for the respective WLASL tiers).
LABELS_COUNT=50
AUDIO_CACHE_TTL_SECONDS=60
